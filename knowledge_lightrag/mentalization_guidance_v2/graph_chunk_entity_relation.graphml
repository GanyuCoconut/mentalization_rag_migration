      <data key="d0">Restoring Mentalization Ability</data>
      <data key="d1">concept</data>
      <data key="d2">The objective of regaining the capacity for mentalization after high arousal.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
