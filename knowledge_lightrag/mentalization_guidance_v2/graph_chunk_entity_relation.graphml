      <data key="d0">GUIDANCE-TOPIC-AROUSAL</data>
      <data key="d1">concept</data>
      <data key="d2">A topic identifier for a guidance framework addressing high emotional arousal and its impact on mentalization.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
      <data key="d6" />
    </node>
    <node id="High Emotional Arousal">
      <data key="d0">High Emotional Arousal</data>
      <data key="d1">concept</data>
      <data key="d2">A state of elevated emotional arousal that leads to decreased mentalization ability and non-mentalizing behavior.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
      <data key="d6" />
    </node>
    <node id="Mentalization Ability">
      <data key="d0">Mentalization Ability</data>
      <data key="d1">concept</data>
      <data key="d2">The capacity to understand one's own and others' mental states, which decreases under high arousal.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
      <data key="d6" />
    </node>
    <node id="Non-Mentalizing Behavior">
      <data key="d0">Non-Mentalizing Behavior</data>
      <data key="d1">concept</data>
      <data key="d2">Behaviors that occur when mentalization is impaired, such as acting without reflection.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
      <data key="d6" />
    </node>
    <node id="Enhanced Stress Response">
      <data key="d0">Enhanced Stress Response</data>
      <data key="d1">concept</data>
      <data key="d2">An increased physiological or psychological reaction to stress, a cue for high arousal.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
      <data key="d6" />
    </node>
    <node id="Enhanced Social Exclusion Response">
      <data key="d0">Enhanced Social Exclusion Response</data>
      <data key="d1">concept</data>
      <data key="d2">An increased reaction to social rejection, a cue for high arousal.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
      <data key="d6" />
    </node>
    <node id="Enhanced Academic Stress Response">
      <data key="d0">Enhanced Academic Stress Response</data>
      <data key="d1">concept</data>
      <data key="d2">An increased reaction to academic pressure, a cue for high arousal.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
      <data key="d6" />
    </node>
    <node id="Lowering Emotional Temperature">
      <data key="d0">Lowering Emotional Temperature</data>
      <data key="d1">concept</data>
      <data key="d2">The goal of reducing emotional intensity to restore mentalization.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
