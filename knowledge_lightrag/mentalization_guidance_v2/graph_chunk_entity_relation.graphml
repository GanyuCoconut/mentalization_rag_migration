      <data key="d1">concept</data>
      <data key="d2">Psychological stress caused by examinations; mentioned as a common experience that can lead to mind blankness.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
