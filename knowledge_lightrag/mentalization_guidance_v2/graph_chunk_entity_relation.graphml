    </node>
    <node id="GUIDANCE-TOPIC-ALIEN-SELF-SHAME">
      <data key="d0">GUIDANCE-TOPIC-ALIEN-SELF-SHAME</data>
      <data key="d1">concept</data>
      <data key="d2">A topic identifier for a guidance framework addressing alien self-shame, including shame and self-hatred in adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Social Understanding Changes">
      <data key="d0">Social Understanding Changes</data>
      <data key="d1">concept</data>
      <data key="d2">Changes in social understanding that are sources of adolescents' shame and self-hatred.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Self-Awareness Enhancement">
      <data key="d0">Self-Awareness Enhancement</data>
      <data key="d1">concept</data>
      <data key="d2">Enhanced self-awareness that is a source of adolescents' shame and self-hatred.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Self-Loathing">
      <data key="d0">Self-Loathing</data>
      <data key="d1">concept</data>
      <data key="d2">Self-loathing as part of the alien self experience, and listed as an applicable clue.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
