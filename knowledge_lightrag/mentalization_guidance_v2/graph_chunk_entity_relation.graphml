    <node id="Being Understood">
      <data key="d0">Being Understood</data>
      <data key="d1">concept</data>
      <data key="d2">The state or concept of feeling understood, mentioned as a keyword.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-002</data>
