    <node id="Lack of Internal Recognition">
      <data key="d0">Lack of Internal Recognition</data>
      <data key="d1">concept</data>
      <data key="d2">Lack of internal recognition, listed as an applicable clue.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
