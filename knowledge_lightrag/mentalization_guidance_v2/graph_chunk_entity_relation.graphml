    </node>
    <node id="Mind Blank">
      <data key="d0">Mind Blank</data>
      <data key="d1">concept</data>
      <data key="d2">A temporary state of memory or thought failure; occurs during high exam stress and is considered normal.</data>
      <data key="d3">doc-2526c2542d1fb9e5640b1a30-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
