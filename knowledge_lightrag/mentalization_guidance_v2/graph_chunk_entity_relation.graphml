  <graph edgedefault="undirected">
    <node id="Adolescent">
      <data key="d0">Adolescent</data>
      <data key="d1">person</data>
      <data key="d2">Adolescent refers to a young person in the developmental stage between childhood and adulthood. Adolescents are the target of various psychological and therapeutic interventions, including psychological support guidelines, mentalizing interventions, avoidance practices, and the Clear Curiosity technique. They are also the presumed recipients of emotional temperature monitoring techniques aimed at exploring subjective experience. In therapeutic contexts, adolescents are treated or understood as individuals whose emotional and cognitive development is a focus of intervention, with the goal of better understanding their internal experiences.&lt;SEP&gt;The young person to whom empathy validation is provided.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-002&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-001&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-003&lt;SEP&gt;doc-e6096597a635e16f1d5f64ea-chunk-001&lt;SEP&gt;doc-cf58af1984b50a1dcb11591e-chunk-001&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-001&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-002&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-001&lt;SEP&gt;doc-24d5ade8ad59b6565d41682f-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-HYPERMENTALIZING.md&lt;SEP&gt;GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md&lt;SEP&gt;GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-AFFECT-IDENTIFICATION.md&lt;SEP&gt;GUIDANCE-TOPIC-MENTALIZING-STANCE.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md&lt;SEP&gt;GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Teleological Mode">
      <data key="d0">Teleological Mode</data>
      <data key="d1">concept</data>
      <data key="d2">A psychological mode characterized by a focus on actions and outcomes rather than internal mental states, relevant to adolescents in therapy.&lt;SEP&gt;A cognitive mode characterized by focus on concrete actions and difficulty recognizing emotions, often seen in adolescents, associated with teleological demands.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-002&lt;SEP&gt;doc-25e2ba2136d79300ee648940-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Mentalization">
      <data key="d0">Mentalization</data>
      <data key="d1">concept</data>
      <data key="d2">The capacity to understand oneself and others in terms of mental states, a key concept in psychological support for adolescents.&lt;SEP&gt;The ability to understand mental states in oneself and others, which the goal aims to promote.&lt;SEP&gt;The ability to understand the mental states of oneself and others.&lt;SEP&gt;The ability to understand mental states of self and others, mentioned as a keyword.&lt;SEP&gt;A psychological process of understanding mental states; direct mentalization exploration or explanation should be avoided when emotional temperature is high.&lt;SEP&gt;A psychological approach used for low-risk, non-diagnostic direct psychological support.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-002&lt;SEP&gt;doc-25e2ba2136d79300ee648940-chunk-000&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-003&lt;SEP&gt;doc-e6096597a635e16f1d5f64ea-chunk-002&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-002&lt;SEP&gt;doc-24d5ade8ad59b6565d41682f-chunk-003</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md&lt;SEP&gt;GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md&lt;SEP&gt;GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Actions And Mental States">
      <data key="d0">Actions And Mental States</data>
      <data key="d1">concept</data>
      <data key="d2">A keyword representing the distinction between observable actions and internal mental processes in psychological contexts.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Low Risk Non Diagnostic Direct Psychological Support">
      <data key="d0">Low Risk Non Diagnostic Direct Psychological Support</data>
      <data key="d1">method</data>
      <data key="d2">A scope of psychological intervention that is direct, low-risk, and non-diagnostic, used as the framework for these guidelines.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Fixed Safety Protocols">
      <data key="d0">Fixed Safety Protocols</data>
      <data key="d1">concept</data>
      <data key="d2">Standardized procedures for managing crisis scenarios in psychological support settings.&lt;SEP&gt;Predefined procedures for handling crisis scenarios.&lt;SEP&gt;Protocols that handle crisis scenarios.&lt;SEP&gt;Established and unchangeable procedures for handling crisis situations to ensure safety.&lt;SEP&gt;Established protocols for handling crisis situations, as mentioned in the scope.&lt;SEP&gt;Predefined procedures for crisis handling; applies to crisis scenarios.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-002&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-002&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-004&lt;SEP&gt;doc-6cf41428683918a1a6480b7e-chunk-002&lt;SEP&gt;doc-e6096597a635e16f1d5f64ea-chunk-002&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-004</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-HYPERMENTALIZING.md&lt;SEP&gt;GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md&lt;SEP&gt;GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md&lt;SEP&gt;GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784707469</data>
      <data key="d6" />
    </node>
    <node id="Analogical Connections">
      <data key="d0">Analogical Connections</data>
      <data key="d1">method</data>
      <data key="d2">A technique of drawing analogical connections, which should be avoided when the adolescent is in teleological mode.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Crisis Scenarios">
      <data key="d0">Crisis Scenarios</data>
      <data key="d1">concept</data>
      <data key="d2">Crisis Scenarios are defined as situations of high risk or emergency that demand immediate intervention and are managed exclusively through fixed safety protocols. These scenarios fall outside the scope of low-risk support and are not addressed via direct mentalization exploration or direct psychological support. Instead, they are handled by predetermined, standardized safety procedures that are applied according to the specific scope and nature of the crisis. The core characteristics include the presence of imminent danger, the need for swift action, and reliance on established protocols rather than exploratory or therapeutic interventions.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-002&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-002&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-004&lt;SEP&gt;doc-6cf41428683918a1a6480b7e-chunk-002&lt;SEP&gt;doc-e6096597a635e16f1d5f64ea-chunk-002&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-002&lt;SEP&gt;doc-24d5ade8ad59b6565d41682f-chunk-003&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-004</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-HYPERMENTALIZING.md&lt;SEP&gt;GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md&lt;SEP&gt;GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md&lt;SEP&gt;GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md&lt;SEP&gt;GUIDANCE-TOPIC-EMPATHY-VALIDATION.md&lt;SEP&gt;GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784707471</data>
      <data key="d6" />
    </node>
    <node id="GUIDANCE-TOPIC-TELEOLOGICAL-MODE">
      <data key="d0">GUIDANCE-TOPIC-TELEOLOGICAL-MODE</data>
      <data key="d1">concept</data>
      <data key="d2">A topic identifier for a guidance mode addressing teleological thinking in adolescents, where only concrete actions and external results are considered real.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Adolescents">
      <data key="d0">Adolescents</data>
      <data key="d1">person</data>
      <data key="d2">Adolescents are young individuals in the developmental stage between childhood and adulthood, typically in their teenage years. They face multiple developmental tasks, including the pursuit of autonomy, formation of peer relationships, and identity construction. Due to an evolutionary mismatch with modern environments, they may experience adaptation difficulties. Adolescents often exhibit a teleological mode of thinking, characterized by a focus on concrete actions and external results, along with difficulty recognizing emotions and exploring the mental states behind actions. They struggle with naming and regulating emotions, and may experience psychic equivalence mode (where inner experience is equated with external reality) and non-mentalizing states. Emotionally, they may feel misunderstood, suffer from emotion dysregulation, and experience strong feelings of shame, self-hatred, despair, and failure. They can internalize an "alien self"—a sense of a foreign or unacceptable part of their identity—leading to self-criticism and self-attack. Additionally, damaged epistemic trust from prior negative experiences can cause skepticism toward social information from others and difficulty learning in safe, relational contexts. When feeling judged or misunderstood, adolescents may close off their inner world. As a result, they are a primary target for therapeutic approaches aimed at addressing self-criticism, shame, and the integration of the alien self, as well as for low-risk, non-diagnostic direct psychological support that seeks to rebuild trust and provide a foundation for healthier development. Empathy validation is also highlighted as important for this demographic.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000&lt;SEP&gt;doc-25e2ba2136d79300ee648940-chunk-001&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-002&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-001&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-002&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-000&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-004&lt;SEP&gt;doc-e6096597a635e16f1d5f64ea-chunk-000&lt;SEP&gt;doc-cf58af1984b50a1dcb11591e-chunk-000&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-000&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-000&lt;SEP&gt;doc-24d5ade8ad59b6565d41682f-chunk-000&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-002&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-001&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-HYPERMENTALIZING.md&lt;SEP&gt;GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md&lt;SEP&gt;GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-AFFECT-IDENTIFICATION.md&lt;SEP&gt;GUIDANCE-TOPIC-MENTALIZING-STANCE.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md&lt;SEP&gt;GUIDANCE-TOPIC-EMPATHY-VALIDATION.md&lt;SEP&gt;GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784707472</data>
      <data key="d6" />
    </node>
    <node id="Actions">
      <data key="d0">Actions</data>
      <data key="d1">concept</data>
      <data key="d2">Concrete behaviors or deeds that are observable and considered real by adolescents.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="External Results">
      <data key="d0">External Results</data>
      <data key="d1">concept</data>
      <data key="d2">Tangible outcomes that are outwardly visible and considered real by adolescents.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Mental States">
      <data key="d0">Mental States</data>
      <data key="d1">concept</data>
      <data key="d2">Internal psychological conditions such as thoughts, feelings, and intentions that adolescents find difficult to explore.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Emotional Causes">
      <data key="d0">Emotional Causes</data>
      <data key="d1">concept</data>
      <data key="d2">Reasons or attributions for emotions that adolescents tend to link to concrete observable events.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Concrete Observable Events">
      <data key="d0">Concrete Observable Events</data>
      <data key="d1">event</data>
      <data key="d2">Specific occurrences that can be directly seen or witnessed, used by adolescents to attribute emotional causes.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Concrete Actions">
      <data key="d0">Concrete Actions</data>
      <data key="d1">concept</data>
      <data key="d2">Tangible deeds that adolescents use as evidence of caring.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Caring">
      <data key="d0">Caring</data>
      <data key="d1">concept</data>
      <data key="d2">The state or concept of caring, which adolescents only recognize through concrete actions.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Emotions">
      <data key="d0">Emotions</data>
      <data key="d1">concept</data>
      <data key="d2">Affective states such as happiness, sadness, anger, etc., which adolescents have difficulty identifying.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Feelings">
      <data key="d0">Feelings</data>
      <data key="d1">concept</data>
      <data key="d2">Subjective experiences that adolescents often confuse with thoughts.&lt;SEP&gt;Emotional states experienced by the teenager.&lt;SEP&gt;The emotional experiences of the patient that are validated.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-003&lt;SEP&gt;doc-24d5ade8ad59b6565d41682f-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-MENTALIZING-STANCE.md&lt;SEP&gt;GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Thoughts">
      <data key="d0">Thoughts</data>
      <data key="d1">concept</data>
      <data key="d2">Cognitive processes or ideas that adolescents may confuse with feelings.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Goal">
      <data key="d0">Goal</data>
      <data key="d1">concept</data>
      <data key="d2">The objective of helping adolescents connect behavior to internal mental states and promote mentalization.&lt;SEP&gt;The objective to explore the adolescent's subjective experience together with a humble, curious, non-expert posture and to restore cooperative mentalization.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784707412</data>
      <data key="d6" />
    </node>
    <node id="Behavior">
      <data key="d0">Behavior</data>
      <data key="d1">concept</data>
      <data key="d2">The actions or conduct of adolescents that the goal aims to connect to internal mental states.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Acting Without Thinking">
      <data key="d0">Acting Without Thinking</data>
      <data key="d1">concept</data>
      <data key="d2">A behavior pattern where adolescents act impulsively without prior reflection, listed as an applicable clue.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Mentalizing Stance">
      <data key="d0">Mentalizing Stance</data>
      <data key="d1">concept</data>
      <data key="d2">A therapeutic stance characterized by curiosity and non-judgment, used in mentalization-based therapy to explore mental states.&lt;SEP&gt;An attitude of exploring adolescents' thoughts with curiosity rather than certainty, acknowledging that uncertainty is normal.&lt;SEP&gt;Therapeutic approach of maintaining non-blaming curiosity.&lt;SEP&gt;A therapeutic approach that involves validating emotions and gently introducing alternative perspectives, emphasizing non-judgmental and non-hating attitudes.&lt;SEP&gt;An approach that interprets adolescent behavior as developmentally functional rather than pathological.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-001&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-001&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-001&lt;SEP&gt;doc-6cf41428683918a1a6480b7e-chunk-001&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-HYPERMENTALIZING.md&lt;SEP&gt;GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md&lt;SEP&gt;GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md&lt;SEP&gt;GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784707469</data>
      <data key="d6" />
    </node>
    <node id="Gentle Challenge">
      <data key="d0">Gentle Challenge</data>
      <data key="d1">method</data>
      <data key="d2">A therapeutic technique that involves questioning teleological demands to explore the feelings and thoughts behind actions.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Teleological Demands">
      <data key="d0">Teleological Demands</data>
      <data key="d1">concept</data>
      <data key="d2">Cognitive demands that focus on concrete actions and ignore underlying mental states, often seen in adolescents.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Distinguishing Feelings and Thoughts">
      <data key="d0">Distinguishing Feelings and Thoughts</data>
      <data key="d1">method</data>
      <data key="d2">A step in Gentle Challenge that involves helping adolescents differentiate between emotions and cognitions.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Reflecting on Interpersonal Experiences">
      <data key="d0">Reflecting on Interpersonal Experiences</data>
      <data key="d1">method</data>
      <data key="d2">A step in Gentle Challenge that involves guiding adolescents to reflect on their interpersonal interactions.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784707196</data>
      <data key="d6" />
    </node>
    <node id="Example Response">
      <data key="d0">Example Response</data>
      <data key="d1">content</data>
      <data key="d2">A specific therapeutic response used in Gentle Challenge, illustrating how to challenge teleological thinking: "You just said that because your friend didn't reply to the message, you think he doesn't care about you."&lt;SEP&gt;A sample dialogue demonstrating the mentalizing technique: "It sounds like you feel everyone hates you, that feeling must be hard. At the same time, is it possible that some people didn't mean that?"</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-001&lt;SEP&gt;doc-6cf41428683918a1a6480b7e-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Over-mentalizing">
      <data key="d0">Over-mentalizing</data>
      <data key="d1">concept</data>
      <data key="d2">Excessive or ungrounded mentalizing where thoughts may jump too far from observable facts.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Curiosity">
      <data key="d0">Curiosity</data>
      <data key="d1">concept</data>
      <data key="d2">An attitude of open exploration, contrasted with certainty, used in the mentalizing stance.&lt;SEP&gt;A component of the mentalization stance involving a desire to learn.&lt;SEP&gt;A state of being curious about the teenager's inner experience.&lt;SEP&gt;A mental state stimulated through empathy validation.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-001&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-001&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-003&lt;SEP&gt;doc-24d5ade8ad59b6565d41682f-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md&lt;SEP&gt;GUIDANCE-TOPIC-MENTALIZING-STANCE.md&lt;SEP&gt;GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Uncertainty">
      <data key="d0">Uncertainty</data>
      <data key="d1">concept</data>
      <data key="d2">A state of not being certain, which is acknowledged as normal and encouraged to be tolerated.&lt;SEP&gt;State of uncertainty, a keyword in the guidelines.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-001&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Challenging Over-mentalizing Technique">
      <data key="d0">Challenging Over-mentalizing Technique</data>
      <data key="d1">method</data>
      <data key="d2">A technique that identifies and gently challenges over-mentalizing to help adolescents connect to here-and-now feelings.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Guiding Back to Observable Facts Step">
      <data key="d0">Guiding Back to Observable Facts Step</data>
      <data key="d1">method</data>
      <data key="d2">A step that points out when adolescents' thoughts have jumped too far and invites them back to observable facts.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Here-and-now Feelings">
      <data key="d0">Here-and-now Feelings</data>
      <data key="d1">concept</data>
      <data key="d2">Feelings experienced in the present moment, which adolescents are helped to connect to.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Observable Facts">
      <data key="d0">Observable Facts</data>
      <data key="d1">concept</data>
      <data key="d2">Empirically verifiable information that serves as a grounding reference.&lt;SEP&gt;Facts that can be observed, a keyword emphasizing grounding in reality.&lt;SEP&gt;Factual information that can be observed, which the goal seeks to return to.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-001&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-000&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Fact">
      <data key="d0">Fact</data>
      <data key="d1">concept</data>
      <data key="d2">Information that is true and can be verified, as opposed to speculation.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Speculation">
      <data key="d0">Speculation</data>
      <data key="d1">concept</data>
      <data key="d2">Conjecture or guesswork not grounded in observable evidence.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="GUIDANCE-TOPIC-HYPERMENTALIZING">
      <data key="d0">GUIDANCE-TOPIC-HYPERMENTALIZING</data>
      <data key="d1">concept</data>
      <data key="d2">A topic identifier for a guidance on hyper-mentalizing in adolescents.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Adolescent Hyper-Mentalizing">
      <data key="d0">Adolescent Hyper-Mentalizing</data>
      <data key="d1">concept</data>
      <data key="d2">A cognitive pattern in adolescents characterized by overthinking others' intentions and complex speculation detached from observable facts.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Overthinking">
      <data key="d0">Overthinking</data>
      <data key="d1">concept</data>
      <data key="d2">A clue of hyper-mentalizing involving excessive thinking about others' motives.&lt;SEP&gt;Excessive thinking, a keyword related to cognitive distortions.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Inaccurate Attribution of Others' Motives or Feelings">
      <data key="d0">Inaccurate Attribution of Others' Motives or Feelings</data>
      <data key="d1">concept</data>
      <data key="d2">A clue of hyper-mentalizing where attributions about others' motives or feelings are incorrect.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Thoughts and Feelings Leaping Too Many Steps from Reality">
      <data key="d0">Thoughts and Feelings Leaping Too Many Steps from Reality</data>
      <data key="d1">concept</data>
      <data key="d2">A clue of hyper-mentalizing where reasoning leaps far from observable reality.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Overinference of Others' Intentions">
      <data key="d0">Overinference of Others' Intentions</data>
      <data key="d1">concept</data>
      <data key="d2">A clue of hyper-mentalizing involving excessive inference about others' intentions.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Reduce Hyper-Mentalizing Goal">
      <data key="d0">Reduce Hyper-Mentalizing Goal</data>
      <data key="d1">concept</data>
      <data key="d2">The goal to reduce hyper-mentalizing, restore tolerance for uncertainty, and return to observable facts.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Tolerance for Uncertainty">
      <data key="d0">Tolerance for Uncertainty</data>
      <data key="d1">concept</data>
      <data key="d2">The ability to tolerate uncertainty about others' intentions, which the goal seeks to restore.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Over-Speculation">
      <data key="d0">Over-Speculation</data>
      <data key="d1">concept</data>
      <data key="d2">Excessive speculation by adolescents, a behavior to be avoided in psychological support.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Direct Denial Without Exploration">
      <data key="d0">Direct Denial Without Exploration</data>
      <data key="d1">concept</data>
      <data key="d2">A response that directly denies an adolescent's thoughts without exploring them, to be avoided in psychological support.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Over-Mentalization">
      <data key="d0">Over-Mentalization</data>
      <data key="d1">concept</data>
      <data key="d2">Excessive mentalizing, a keyword indicating a tendency to over-analyze others' thoughts.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Low-Risk Non-Diagnostic Direct Psychological Support">
      <data key="d0">Low-Risk Non-Diagnostic Direct Psychological Support</data>
      <data key="d1">concept</data>
      <data key="d2">A type of psychological support that is low-risk, non-diagnostic, and direct, used for general guidance.&lt;SEP&gt;The scope of psychological support that is provided directly to individuals in low-risk situations and does not involve formal diagnosis.&lt;SEP&gt;A scope of psychological support that is low-risk, non-diagnostic, and used for direct support.&lt;SEP&gt;A type of psychological support that is low-risk and non-diagnostic, provided directly to individuals.&lt;SEP&gt;A type of psychological support that is low-risk and non-diagnostic, within the scope of mentalization.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-002&lt;SEP&gt;doc-6cf41428683918a1a6480b7e-chunk-002&lt;SEP&gt;doc-e6096597a635e16f1d5f64ea-chunk-002&lt;SEP&gt;doc-cf58af1984b50a1dcb11591e-chunk-001&lt;SEP&gt;doc-24d5ade8ad59b6565d41682f-chunk-003</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md&lt;SEP&gt;GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md&lt;SEP&gt;GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-AFFECT-IDENTIFICATION.md&lt;SEP&gt;GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Response Examples">
      <data key="d0">Response Examples</data>
      <data key="d1">content</data>
      <data key="d2">Example responses for engaging adolescents, such as asking about known vs guessed information.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Psychological Support Guidelines">
      <data key="d0">Psychological Support Guidelines</data>
      <data key="d1">content</data>
      <data key="d2">A set of guidelines for providing psychological support to adolescents, including response examples, avoidances, keywords, and scope.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784707210</data>
      <data key="d6" />
    </node>
    <node id="Inner Critic">
      <data key="d0">Inner Critic</data>
      <data key="d1">concept</data>
      <data key="d2">A harsh inner voice that criticizes oneself, often originating from external judgments.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-003</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Shame">
      <data key="d0">Shame</data>
      <data key="d1">concept</data>
      <data key="d2">A strong feeling of shame experienced by adolescents, potentially leading to internalization of an alien self.&lt;SEP&gt;An emotion that drives self-attack in adolescents, explored with non-blaming curiosity.&lt;SEP&gt;A feeling of embarrassment or humiliation that adolescents may feel in relation to self-criticism.&lt;SEP&gt;A painful feeling of humiliation or distress.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-003&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-001&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-002&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Self-Hatred">
      <data key="d0">Self-Hatred</data>
      <data key="d1">concept</data>
      <data key="d2">Self-hatred experienced by adolescents, potentially leading to internalization of an alien self.&lt;SEP&gt;An intense dislike of oneself, explored in relation to past influences and the alien self.&lt;SEP&gt;Intense dislike or hatred of oneself.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-003&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-002&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Alien Self">
      <data key="d0">Alien Self</data>
      <data key="d1">concept</data>
      <data key="d2">An internalized experience characterized by persistent self-criticism, self-loathing, and anticipated failure.&lt;SEP&gt;Parts of the self felt as foreign, formed from caregiver misattributions, addressed by mentalizing technique.&lt;SEP&gt;A part of the self that is perceived as foreign or not genuine, often expressed through self-attack or a strict inner critic.&lt;SEP&gt;A part of the self that feels foreign or imposed from outside.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-003&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-001&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-002&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Others' Judgments">
      <data key="d0">Others' Judgments</data>
      <data key="d1">concept</data>
      <data key="d2">Perceptions or criticisms from other people that become internalized.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-003</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="First Response Example">
      <data key="d0">First Response Example</data>
      <data key="d1">content</data>
      <data key="d2">A sample therapeutic response that acknowledges an inner critical voice and asks about its origin.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-003</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Second Response Example">
      <data key="d0">Second Response Example</data>
      <data key="d1">content</data>
      <data key="d2">A sample therapeutic response that suggests a connection between self-criticism and the internalization of others' views.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-003</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Guilt">
      <data key="d0">Guilt</data>
      <data key="d1">concept</data>
      <data key="d2">A painful feeling of responsibility or remorse, mentioned alongside shame in an avoidance instruction.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-003</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Self-Attack">
      <data key="d0">Self-Attack</data>
      <data key="d1">concept</data>
      <data key="d2">A harmful behavior directed at oneself, driven by shame, reduced through mentalizing.&lt;SEP&gt;The act of criticizing or blaming oneself, which is reframed as an expression of the alien self.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-001&lt;SEP&gt;doc-c67b74097efa61deeed03804-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Caregivers">
      <data key="d0">Caregivers</data>
      <data key="d1">person</data>
      <data key="d2">Individuals whose misattributions contribute to the formation of alien self in adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Non-blaming Curiosity">
      <data key="d0">Non-blaming Curiosity</data>
      <data key="d1">concept</data>
      <data key="d2">Attitude of exploring without blame, central to mentalizing.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Mentalizing Alien Self Technique">
      <data key="d0">Mentalizing Alien Self Technique</data>
      <data key="d1">method</data>
      <data key="d2">Therapeutic technique to help adolescents identify, integrate, and externalize alien self parts, understanding origin in caregiver misattributions.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Despair">
      <data key="d0">Despair</data>
      <data key="d1">concept</data>
      <data key="d2">A feeling of hopelessness experienced by adolescents, stated at the beginning of the input text.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Failure Feeling">
      <data key="d0">Failure Feeling</data>
      <data key="d1">concept</data>
      <data key="d2">The feeling of being a failure experienced by adolescents, as expressed in "feels like a failure".</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Pressure">
      <data key="d0">Pressure</data>
      <data key="d1">concept</data>
      <data key="d2">A stress or demand that is externalized as part of the therapeutic process.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Self-Criticism">
      <data key="d0">Self-Criticism</data>
      <data key="d1">concept</data>
      <data key="d2">An internal critical voice that adolescents experience, often leading to shame.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="True Self">
      <data key="d0">True Self</data>
      <data key="d1">concept</data>
      <data key="d2">The authentic self that is distinguished from the alien self during therapeutic exploration.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Critical Voice">
      <data key="d0">Critical Voice</data>
      <data key="d1">concept</data>
      <data key="d2">The inner voice that criticizes the adolescent, a component of self-criticism.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Strict Part">
      <data key="d0">Strict Part</data>
      <data key="d1">concept</data>
      <data key="d2">A harsh, critical aspect of the personality that blames the adolescent, seen as a manifestation of the alien self.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Past Others">
      <data key="d0">Past Others</data>
      <data key="d1">person</data>
      <data key="d2">Individuals from the adolescent's past whose opinions may have contributed to the development of self-hatred and the alien self.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
      <data key="d6" />
    </node>
    <node id="Gentle Curiosity">
      <data key="d0">Gentle Curiosity</data>
      <data key="d1">method</data>
      <data key="d2">A therapeutic approach of asking with gentle curiosity to explore the specific content of self-criticism and shame in adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784707218</data>
