      <data key="d6" />
    </node>
    <node id="Psychic Equivalence Mode">
      <data key="d0">Psychic Equivalence Mode</data>
      <data key="d1">concept</data>
      <data key="d2">A mental state in which adolescents experience thoughts and feelings as equivalent to reality; they feel misunderstood and are in a non-mentalizing state.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Non-Mentalizing State">
      <data key="d0">Non-Mentalizing State</data>
      <data key="d1">concept</data>
      <data key="d2">A state where the capacity to understand mental states is impaired; adolescents in this state feel misunderstood.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Emotion Dysregulation">
      <data key="d0">Emotion Dysregulation</data>
      <data key="d1">concept</data>
      <data key="d2">A condition of difficulty managing emotions; adolescents experience this.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Empathy Validation">
      <data key="d0">Empathy Validation</data>
      <data key="d1">method</data>
      <data key="d2">A method used to restore mentalizing by understanding and validating the adolescent's experience; it aims to establish a shared platform and reduce interpersonal heat.&lt;SEP&gt;A concept emphasizing validation of the patient's feelings through empathic understanding, as demonstrated in the response example.&lt;SEP&gt;A technique of empathy validation with steps including closely following adolescents to stimulate curiosity and differences.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000&lt;SEP&gt;doc-24d5ade8ad59b6565d41682f-chunk-002&lt;SEP&gt;doc-24d5ade8ad59b6565d41682f-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Mentalizing">
      <data key="d0">Mentalizing</data>
      <data key="d1">concept</data>
      <data key="d2">The capacity to understand one's own and others' mental states; the goal is to restore it through empathy validation.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Shared Platform">
      <data key="d0">Shared Platform</data>
      <data key="d1">concept</data>
      <data key="d2">A common ground of understanding established through empathy validation.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
      <data key="d6" />
    </node>
    <node id="Interpersonal Heat">
      <data key="d0">Interpersonal Heat</data>
      <data key="d1">concept</data>
      <data key="d2">The level of emotional intensity in interactions; empathy validation aims to reduce it.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784707464</data>
