      <data key="d0">Shared Attention</data>
      <data key="d1">method</data>
      <data key="d2">A technique involving joint focus of attention.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
