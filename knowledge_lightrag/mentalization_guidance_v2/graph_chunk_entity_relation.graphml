    <node id="Automatic Trust Assumption">
      <data key="d0">Automatic Trust Assumption</data>
      <data key="d1">concept</data>
      <data key="d2">The assumption that professional roles or qualifications automatically bring trust, which is to be avoided.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
    <node id="GUIDANCE-TOPIC-EPISTEMIC-TRUST">
      <data key="d0">GUIDANCE-TOPIC-EPISTEMIC-TRUST</data>
      <data key="d1">content</data>
      <data key="d2">The topic identifier for guidance addressing epistemic trust damage in adolescents.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
    <node id="Epistemic Trust">
      <data key="d0">Epistemic Trust</data>
      <data key="d1">concept</data>
      <data key="d2">The cognitive trust that is damaged in adolescents due to prior experiences, causing skepticism towards social information.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
    <node id="Professional Help">
      <data key="d0">Professional Help</data>
      <data key="d1">concept</data>
      <data key="d2">Assistance from professionals that adolescents with damaged epistemic trust have difficulty accepting.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
    <node id="Accurate Mentalization">
      <data key="d0">Accurate Mentalization</data>
      <data key="d1">concept</data>
      <data key="d2">The process of being accurately mentalized by others, which is the target for repairing epistemic trust and restoring the ability to learn from social experiences.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
    <node id="Prior Experiences">
      <data key="d0">Prior Experiences</data>
      <data key="d1">concept</data>
      <data key="d2">Past experiences of adolescents that caused damage to their epistemic trust.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
    <node id="Social Information">
      <data key="d0">Social Information</data>
      <data key="d1">concept</data>
      <data key="d2">Information from others that adolescents with damaged epistemic trust are deeply skeptical of.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
    <node id="Ability to Learn from Social Experiences">
      <data key="d0">Ability to Learn from Social Experiences</data>
      <data key="d1">concept</data>
      <data key="d2">The capacity to learn from social experiences that is restored through accurate mentalization.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
    <node id="Help">
      <data key="d0">Help</data>
      <data key="d1">concept</data>
      <data key="d2">Assistance from others that adolescents with damaged epistemic trust are highly vigilant about.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
