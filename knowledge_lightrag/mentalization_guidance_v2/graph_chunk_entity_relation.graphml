    <node id="Problem Framework">
      <data key="d0">Problem Framework</data>
      <data key="d1">concept</data>
      <data key="d2">Describes the issue that adolescents have difficulty naming emotions and lack vocabulary for emotional states, limiting interaction and regulation.&lt;SEP&gt;A framework describing how high emotional arousal leads to decreased mentalization ability and non-mentalizing behavior.</data>
      <data key="d3">doc-cf58af1984b50a1dcb11591e-chunk-000&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
