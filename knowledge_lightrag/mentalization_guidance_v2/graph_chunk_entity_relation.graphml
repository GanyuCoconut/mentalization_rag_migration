      <data key="d5">1784707469</data>
      <data key="d6" />
    </node>
    <node id="Identity">
      <data key="d0">Identity</data>
      <data key="d1">concept</data>
      <data key="d2">A developmental task for adolescents, involving the formation of a coherent sense of self.&lt;SEP&gt;An individual's sense of self and personal identity, about which teenagers are encouraged to express their feelings.&lt;SEP&gt;Sense of self; key aspect of adolescent development mentioned in keywords.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-004&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-000&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-003</data>
