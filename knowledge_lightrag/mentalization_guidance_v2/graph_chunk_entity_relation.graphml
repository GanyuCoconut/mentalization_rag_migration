    <node id="Anticipated Failure">
      <data key="d0">Anticipated Failure</data>
      <data key="d1">concept</data>
      <data key="d2">Expectation of failure as part of the alien self experience, and listed as an applicable clue.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
