      <data key="d5">1784707469</data>
      <data key="d6" />
    </node>
    <node id="Psychic Equivalence">
      <data key="d0">Psychic Equivalence</data>
      <data key="d1">concept</data>
      <data key="d2">A psychological phenomenon where inner feelings are experienced as absolute external reality, causing difficulty distinguishing internal thoughts from external facts and leading to anxiety and distress.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Anxiety And Distress">
      <data key="d0">Anxiety And Distress</data>
      <data key="d1">concept</data>
      <data key="d2">Emotional consequences resulting from psychic equivalence.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Perceiving Criticism As Threatening Attack">
      <data key="d0">Perceiving Criticism As Threatening Attack</data>
      <data key="d1">concept</data>
      <data key="d2">A clue indicating psychic equivalence where an individual perceives criticism as a threatening attack.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Rejecting Feelings As Literal Pain">
      <data key="d0">Rejecting Feelings As Literal Pain</data>
      <data key="d1">concept</data>
      <data key="d2">A clue indicating psychic equivalence where an individual rejects feelings as literal physical pain.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Goal Of Distinguishing Feelings From Facts">
      <data key="d0">Goal Of Distinguishing Feelings From Facts</data>
      <data key="d1">concept</data>
      <data key="d2">The therapeutic goal to help individuals differentiate between subjective feelings and objective reality.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Multi-Perspective Thinking">
      <data key="d0">Multi-Perspective Thinking</data>
      <data key="d1">concept</data>
      <data key="d2">The ability to consider multiple viewpoints, which is to be restored.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Treating Inner Thoughts As Reality">
      <data key="d0">Treating Inner Thoughts As Reality</data>
      <data key="d1">concept</data>
      <data key="d2">A clue indicating psychic equivalence where an individual treats inner thoughts as absolute reality.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Inability To Distinguish Internal State From External Reality">
      <data key="d0">Inability To Distinguish Internal State From External Reality</data>
      <data key="d1">concept</data>
      <data key="d2">A clue indicating psychic equivalence where an individual is unable to distinguish internal states from external reality.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Validating Emotions">
      <data key="d0">Validating Emotions</data>
      <data key="d1">method</data>
      <data key="d2">A technique used to acknowledge and validate the teenager's feelings as real and understandable.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Non-judgmental">
      <data key="d0">Non-judgmental</data>
      <data key="d1">concept</data>
      <data key="d2">A principle of not judging the teenager's emotions or experiences.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Non-hating">
      <data key="d0">Non-hating</data>
      <data key="d1">concept</data>
      <data key="d2">A principle of not harboring hatred towards the teenager or their emotions.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Teenagers">
      <data key="d0">Teenagers</data>
      <data key="d1">person</data>
      <data key="d2">Adolescents who are the recipients of the mentalizing intervention, whose emotions are validated and alternative perspectives are offered.&lt;SEP&gt;Adolescent individuals typically aged 13-19, who are the recipients of psychological support.&lt;SEP&gt;Human individuals in the adolescent stage, who are encouraged to express feelings about autonomy, identity, and peer relationships, and who feel burdened by responsibilities but lack decision-making power.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-001&lt;SEP&gt;doc-6cf41428683918a1a6480b7e-chunk-002&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-003</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md&lt;SEP&gt;GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784707469</data>
      <data key="d6" />
    </node>
    <node id="Alternative Perspective">
      <data key="d0">Alternative Perspective</data>
      <data key="d1">concept</data>
      <data key="d2">Another viewpoint gently introduced to help distinguish internal feelings from external reality.&lt;SEP&gt;A technique to consider a different viewpoint or interpretation of a situation.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-001&lt;SEP&gt;doc-6cf41428683918a1a6480b7e-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Internal Feelings">
      <data key="d0">Internal Feelings</data>
      <data key="d1">concept</data>
      <data key="d2">Subjective emotional experiences of the teenager that are acknowledged and validated.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="External Reality">
      <data key="d0">External Reality</data>
      <data key="d1">concept</data>
      <data key="d2">Objective circumstances outside the teenager's internal experience, used to differentiate from subjective feelings.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Mentalizing Technique">
      <data key="d0">Mentalizing Technique</data>
      <data key="d1">method</data>
      <data key="d2">A method that involves validating emotions and gently introducing alternative perspectives to teenagers.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Mentalizing Steps">
      <data key="d0">Mentalizing Steps</data>
      <data key="d1">method</data>
      <data key="d2">A procedure consisting of first validating the teenager's emotions and then gently proposing an alternative perspective to help distinguish internal feelings from external reality.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-001</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Direct Negation Of Teenagers' Feelings">
      <data key="d0">Direct Negation Of Teenagers' Feelings</data>
      <data key="d1">concept</data>
      <data key="d2">A practice of dismissing or invalidating the emotional experiences of teenagers, which should be avoided.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Psychological Equivalence">
      <data key="d0">Psychological Equivalence</data>
      <data key="d1">concept</data>
      <data key="d2">The idea that psychological states have an equivalence to factual reality in terms of their impact on individuals.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Distinguish Feelings From Facts">
      <data key="d0">Distinguish Feelings From Facts</data>
      <data key="d1">method</data>
      <data key="d2">A technique to separate subjective emotional experiences from objective factual information.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Validate Emotions">
      <data key="d0">Validate Emotions</data>
      <data key="d1">method</data>
      <data key="d2">A technique to acknowledge and accept a person's emotions as valid without judgment.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784707276</data>
      <data key="d6" />
    </node>
    <node id="Mentalization Stance">
      <data key="d0">Mentalization Stance</data>
      <data key="d1">concept</data>
      <data key="d2">A stance of maintaining an available mindset and understanding the adolescent's situation.&lt;SEP&gt;A therapeutic stance characterized by curiosity, not-knowing, and a non-expert attitude.&lt;SEP&gt;A psychological stance used for direct psychological support, applicable only to low-risk and non-diagnostic situations.&lt;SEP&gt;An approach of empathically understanding adolescents' emotional experiences.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-001&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-001&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-004&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-MENTALIZING-STANCE.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784707427</data>
      <data key="d6" />
    </node>
    <node id="Cognitive Trust">
      <data key="d0">Cognitive Trust</data>
      <data key="d1">concept</data>
      <data key="d2">Trust built through shared attention and emotional regulation.&lt;SEP&gt;A concept referring to trust based on competence and reliability, mentioned as a keyword.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-001&lt;SEP&gt;doc-e6096597a635e16f1d5f64ea-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784707288</data>
      <data key="d6" />
    </node>
