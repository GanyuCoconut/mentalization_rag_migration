      <data key="d1">concept</data>
      <data key="d2">A component of evolutionary mismatch where responsibility and autonomy are unbalanced.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-002</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
