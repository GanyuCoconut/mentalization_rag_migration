  },
  "doc-cf58af1984b50a1dcb11591e-chunk-001": {
    "tokens": 61,
    "content": "避免事项：直接告诉青少年他/她应该有什么感受\n关键词：情绪命名；\n\n情绪识别；\n\n情绪标签化；\n\n情绪调节\n范围：仅用于低风险、非诊断性的直接心理支持；\n\n危机场景由固定安全协议处理。",
    "chunk_order_index": 1,
    "split_type": "hard_fallback",
    "split_part": 2,
    "split_total": 2,
    "full_doc_id": "doc-cf58af1984b50a1dcb11591e",
