    ],
    "create_time": 1784707099,
    "update_time": 1784707212,
    "_id": "doc-c67b74097efa61deeed03804-chunk-003"
  },
  "doc-c67b74097efa61deeed03804-chunk-004": {
    "tokens": 27,
    "content": "青少年\n范围：仅用于低风险、非诊断性的直接心理支持；\n\n危机场景由固定安全协议处理。",
    "chunk_order_index": 4,
    "split_type": "hard_fallback",
    "split_part": 5,
    "split_total": 5,
    "full_doc_id": "doc-c67b74097efa61deeed03804",
