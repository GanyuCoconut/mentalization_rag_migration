    ],
    "create_time": 1784707413,
    "update_time": 1784707450,
    "_id": "doc-24d5ade8ad59b6565d41682f-chunk-000"
  },
  "doc-24d5ade8ad59b6565d41682f-chunk-001": {
    "tokens": 55,
    "content": "；\n\n验证立场：真诚地验证患者的感受。\n\n技术：共情验证\n步骤：紧贴青少年，提供共情验证，以激发好奇心和差异。\n\n；\n\n先验证感受，再温和挑战其思维过程。",
    "chunk_order_index": 1,
    "split_type": "hard_fallback",
    "split_part": 2,
