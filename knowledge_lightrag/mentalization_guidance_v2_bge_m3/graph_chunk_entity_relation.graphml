  <graph edgedefault="undirected">
    <node id="Empathy Validation">
      <data key="d0">Empathy Validation</data>
      <data key="d1">method</data>
      <data key="d2">A technique used to restore mentalizing, build a shared platform, and reduce interpersonal heat in adolescents by providing empathy, support, and validation.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Adolescent">
      <data key="d0">Adolescent</data>
      <data key="d1">person</data>
      <data key="d2">Individuals in the adolescent age group who may be in psychic equivalence mode or a non-mentalizing state, feeling misunderstood and experiencing emotional dysregulation.&lt;SEP&gt;A young person who has damaged epistemic trust due to prior experiences, leading to wariness of help and deep skepticism of new information from others.&lt;SEP&gt;A young person who may receive guidance on psychic equivalence, specifically addressed in the response example.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000&lt;SEP&gt;doc-e6096597a635e16f1d5f64ea-chunk-000&lt;SEP&gt;doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md&lt;SEP&gt;GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Psychic Equivalence Mode">
      <data key="d0">Psychic Equivalence Mode</data>
      <data key="d1">concept</data>
      <data key="d2">A mental state where the adolescent's thoughts and feelings are experienced as universally true and equivalent to external reality.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Non-Mentalizing State">
      <data key="d0">Non-Mentalizing State</data>
      <data key="d1">concept</data>
      <data key="d2">A state in which the adolescent is unable to consider or reflect on their own or others' mental states.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Emotional Dysregulation">
      <data key="d0">Emotional Dysregulation</data>
      <data key="d1">concept</data>
      <data key="d2">Difficulty in managing emotional responses, leading to intense, unstable, or overwhelming emotions.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Mentalizing">
      <data key="d0">Mentalizing</data>
      <data key="d1">concept</data>
      <data key="d2">The ability to understand and interpret the mental states (thoughts, feelings, intentions) of oneself and others.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Empathy Validation Stance">
      <data key="d0">Empathy Validation Stance</data>
      <data key="d1">concept</data>
      <data key="d2">A mentalizing stance that involves understanding the adolescent's experience and providing support, empathy, and validation.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Validation Stance">
      <data key="d0">Validation Stance</data>
      <data key="d1">concept</data>
      <data key="d2">A stance that sincerely validates the adolescent's feelings without judgment.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Shared Platform">
      <data key="d0">Shared Platform</data>
      <data key="d1">concept</data>
      <data key="d2">A common understanding and connection built between the adolescent and the supporter through empathy validation.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Interpersonal Heat">
      <data key="d0">Interpersonal Heat</data>
      <data key="d1">concept</data>
      <data key="d2">The emotional intensity or tension present in the interaction between the adolescent and the supporter.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="GUIDANCE-TOPIC-EMPATHY-VALIDATION">
      <data key="d0">GUIDANCE-TOPIC-EMPATHY-VALIDATION</data>
      <data key="d1">artifact</data>
      <data key="d2">The unique identifier for the empathy validation topic guidance document.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Response Example">
      <data key="d0">Response Example</data>
      <data key="d1">content</data>
      <data key="d2">A specific illustrative response provided to demonstrate how empathy validation is applied, including validation of feelings and gentle challenge of thought processes.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md</data>
      <data key="d5">1784709486</data>
      <data key="d6" />
    </node>
    <node id="Crisis Scenario">
      <data key="d0">Crisis Scenario</data>
      <data key="d1">event</data>
      <data key="d2">A high-risk psychological support situation that is excluded from the scope of empathy validation and handled by fixed safety protocols.&lt;SEP&gt;Scenarios that are handled by the fixed safety protocol, not by the mentalizing stance guidance.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md&lt;SEP&gt;GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="Fixed Safety Protocols">
      <data key="d0">Fixed Safety Protocols</data>
      <data key="d1">method</data>
      <data key="d2">Predefined procedures used to manage crisis scenarios in psychological support, separate from the empathy validation technique.&lt;SEP&gt;Established procedures for handling crisis scenarios, which are separate from the low-risk support framework.&lt;SEP&gt;Protocols to handle crisis scenarios separately from this guidance.&lt;SEP&gt;Predefined procedures that manage crisis scenarios, distinct from the emotion labeling technique.</data>
      <data key="d3">doc-24d5ade8ad59b6565d41682f-chunk-000&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-000&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-000&lt;SEP&gt;doc-cf58af1984b50a1dcb11591e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EMPATHY-VALIDATION.md&lt;SEP&gt;GUIDANCE-TOPIC-HYPERMENTALIZING.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md&lt;SEP&gt;GUIDANCE-TOPIC-AFFECT-IDENTIFICATION.md</data>
      <data key="d5">1784709629</data>
      <data key="d6" />
    </node>
    <node id="Alien Self">
      <data key="d0">Alien Self</data>
      <data key="d1">concept</data>
      <data key="d2">An internal experience of persistent self-criticism, self-hatred, and expected failure, perceived as a separate part of the self formed from caregivers' misattributions.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Shame">
      <data key="d0">Shame</data>
      <data key="d1">concept</data>
      <data key="d2">A feeling of intense shame experienced by adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Self-hatred">
      <data key="d0">Self-hatred</data>
      <data key="d1">concept</data>
      <data key="d2">A feeling of self-hatred experienced by adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Self-loathing">
      <data key="d0">Self-loathing</data>
      <data key="d1">concept</data>
      <data key="d2">A feeling of self-loathing experienced by adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Persistent Self-criticism">
      <data key="d0">Persistent Self-criticism</data>
      <data key="d1">concept</data>
      <data key="d2">Ongoing internal criticism and self-blame experienced by adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Expected Failure">
      <data key="d0">Expected Failure</data>
      <data key="d1">concept</data>
      <data key="d2">An expectation of failure in various aspects of life experienced by adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Despair">
      <data key="d0">Despair</data>
      <data key="d1">concept</data>
      <data key="d2">A feeling of hopelessness and despair experienced by adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Adolescents">
      <data key="d0">Adolescents</data>
      <data key="d1">person</data>
      <data key="d2">Individuals in the adolescent developmental stage who may experience shame, self-hatred, and the alien self.&lt;SEP&gt;Adolescents who may feel judged or misunderstood and may close off or use vague statements to avoid revealing true feelings.&lt;SEP&gt;The target population for the guidance framework, who exhibit over-mentalizing tendencies.&lt;SEP&gt;The target group for the guidance, who may exhibit teleological mode by focusing on concrete actions and external results.&lt;SEP&gt;The target population for this guidance topic, who experience emotional arousal and stress.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-000&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-000&lt;SEP&gt;doc-25e2ba2136d79300ee648940-chunk-000&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md&lt;SEP&gt;GUIDANCE-TOPIC-MENTALIZING-STANCE.md&lt;SEP&gt;GUIDANCE-TOPIC-HYPERMENTALIZING.md&lt;SEP&gt;GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784709610</data>
      <data key="d6" />
    </node>
    <node id="Caregivers">
      <data key="d0">Caregivers</data>
      <data key="d1">person</data>
      <data key="d2">Individuals who provide care and whose misattributions contribute to the formation of the alien self in adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Non-blaming Curiosity">
      <data key="d0">Non-blaming Curiosity</data>
      <data key="d1">concept</data>
      <data key="d2">A mentalizing stance characterized by curious inquiry without blame, used to explore the alien self.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Mentalization">
      <data key="d0">Mentalization</data>
      <data key="d1">concept</data>
      <data key="d2">The ability to understand and interpret mental states of oneself and others, used in therapeutic techniques.&lt;SEP&gt;The ability to understand behavior in terms of mental states; the goal of the guidance is to promote mentalization in adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000&lt;SEP&gt;doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md&lt;SEP&gt;GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Mentalizing The Alien Self">
      <data key="d0">Mentalizing The Alien Self</data>
      <data key="d1">method</data>
      <data key="d2">A technique to help adolescents identify and integrate parts of the alien self by exploring its relational origins and externalizing its influence.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Relational Source">
      <data key="d0">Relational Source</data>
      <data key="d1">concept</data>
      <data key="d2">The origin of the alien self in past relationships, particularly with caregivers.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Misattribution">
      <data key="d0">Misattribution</data>
      <data key="d1">concept</data>
      <data key="d2">Incorrect attributions made by caregivers regarding the adolescent's mental states, leading to the alien self.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Shame-driven Self-attack">
      <data key="d0">Shame-driven Self-attack</data>
      <data key="d1">concept</data>
      <data key="d2">Self-critical behavior driven by shame, manifesting as self-blame and self-hatred.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Internalization">
      <data key="d0">Internalization</data>
      <data key="d1">concept</data>
      <data key="d2">The process by which external judgments or expectations become internal mental representations, forming the alien self.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Lack Of Internal Approval">
      <data key="d0">Lack Of Internal Approval</data>
      <data key="d1">concept</data>
      <data key="d2">The feeling of lacking internal approval and validation, contributing to self-criticism and shame in adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Feeling Of Being A Failure">
      <data key="d0">Feeling Of Being A Failure</data>
      <data key="d1">concept</data>
      <data key="d2">The feeling of being a failure, associated with despair and self-loathing in adolescents.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Changes In Social Understanding">
      <data key="d0">Changes In Social Understanding</data>
      <data key="d1">concept</data>
      <data key="d2">Changes in an adolescent's understanding of social norms and expectations, which give rise to feelings of shame and self-hatred.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Enhanced Self-awareness">
      <data key="d0">Enhanced Self-awareness</data>
      <data key="d1">concept</data>
      <data key="d2">An increase in self-awareness during adolescence, which heightens self-criticism and contributes to shame and self-hatred.</data>
      <data key="d3">doc-c67b74097efa61deeed03804-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ALIEN-SELF-SHAME.md</data>
      <data key="d5">1784709492</data>
      <data key="d6" />
    </node>
    <node id="Epistemic Trust">
      <data key="d0">Epistemic Trust</data>
      <data key="d1">concept</data>
      <data key="d2">A concept referring to trust in knowledge from others; in the context, it is damaged in adolescents due to prior experiences, causing skepticism towards social information.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Social Information">
      <data key="d0">Social Information</data>
      <data key="d1">content</data>
      <data key="d2">Information coming from other people; adolescents with damaged epistemic trust are skeptical of it.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Professional Help">
      <data key="d0">Professional Help</data>
      <data key="d1">concept</data>
      <data key="d2">Assistance from professionals; adolescents with damaged epistemic trust are reluctant to accept it.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Mentalizing Stance">
      <data key="d0">Mentalizing Stance</data>
      <data key="d1">concept</data>
      <data key="d2">An approach where the therapist maintains mental availability, understands the adolescent's situation, and is willing to learn from the adolescent to understand them.&lt;SEP&gt;A stance of curiosity, not-knowing, and non-expert attitude, used to collaboratively explore the adolescent's subjective experience and restore collaborative mentalizing.&lt;SEP&gt;An approach that understands adolescent behaviors from a developmental perspective rather than as pathological, balancing autonomy and family participation.&lt;SEP&gt;An approach characterized by curiosity rather than certainty when exploring adolescents' thoughts, acknowledging uncertainty as normal.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000&lt;SEP&gt;doc-c5160492e097bac38980aeda-chunk-000&lt;SEP&gt;doc-cbd65c5b9066cfdab9aefc4e-chunk-000&lt;SEP&gt;doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-MENTALIZING-STANCE.md&lt;SEP&gt;GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md&lt;SEP&gt;GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Joint Attention">
      <data key="d0">Joint Attention</data>
      <data key="d1">method</data>
      <data key="d2">A technique used to build epistemic trust through shared focus and affect regulation.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Affect Regulation">
      <data key="d0">Affect Regulation</data>
      <data key="d1">method</data>
      <data key="d2">A technique used together with joint attention to build epistemic trust.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Accurate Mentalizing">
      <data key="d0">Accurate Mentalizing</data>
      <data key="d1">method</data>
      <data key="d2">The process of demonstrating accurate understanding of the adolescent in interaction, making them feel seen and understood.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Therapist">
      <data key="d0">Therapist</data>
      <data key="d1">person</data>
      <data key="d2">The professional providing support; uses mentalizing stance and techniques to help the adolescent restore epistemic trust.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Safety Protocol">
      <data key="d0">Safety Protocol</data>
      <data key="d1">artifact</data>
      <data key="d2">A fixed protocol that handles crisis scenarios; limits the scope of the guidance to low-risk, non-diagnostic support.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Safe Learning">
      <data key="d0">Safe Learning</data>
      <data key="d1">concept</data>
      <data key="d2">The ability to learn safely from social experiences; the goal is to restore this ability for the adolescent.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Prior Experiences">
      <data key="d0">Prior Experiences</data>
      <data key="d1">event</data>
      <data key="d2">Previous experiences of the adolescent that caused damage to epistemic trust.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="Crisis Scenarios">
      <data key="d0">Crisis Scenarios</data>
      <data key="d1">event</data>
      <data key="d2">Urgent situations handled by a fixed safety protocol, outside the scope of low-risk support.&lt;SEP&gt;High-risk situations that are handled by fixed safety protocols, not by this guidance.&lt;SEP&gt;Emergency situations that are handled by fixed safety protocols, excluded from the low-risk scope of the technique.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-000&lt;SEP&gt;doc-cf58af1984b50a1dcb11591e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md&lt;SEP&gt;GUIDANCE-TOPIC-AFFECT-IDENTIFICATION.md</data>
      <data key="d5">1784709629</data>
      <data key="d6" />
    </node>
    <node id="Rigidity">
      <data key="d0">Rigidity</data>
      <data key="d1">other</data>
      <data key="d2">A behavioral characteristic of adolescents with damaged epistemic trust, appearing stubborn and inflexible.</data>
      <data key="d3">doc-e6096597a635e16f1d5f64ea-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-EPISTEMIC-TRUST.md</data>
      <data key="d5">1784709504</data>
      <data key="d6" />
    </node>
    <node id="GUIDANCE-TOPIC-MENTALIZING-STANCE">
      <data key="d0">GUIDANCE-TOPIC-MENTALIZING-STANCE</data>
      <data key="d1">concept</data>
      <data key="d2">A topic identifier for a guidance on mentalizing stance with adolescents.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="Patient">
      <data key="d0">Patient</data>
      <data key="d1">person</data>
      <data key="d2">Individuals, specifically adolescents, who exhibit non-mentalizing behaviors such as absolute statements, emotional agitation, and lack of curiosity about internal states.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="Non-Mentalizing">
      <data key="d0">Non-Mentalizing</data>
      <data key="d1">concept</data>
      <data key="d2">State where the patient lacks mentalizing, characterized by absolute statements, emotional agitation, and lack of curiosity about self or others.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="Tentative Language Technique">
      <data key="d0">Tentative Language Technique</data>
      <data key="d1">method</data>
      <data key="d2">A technique using tentative language (e.g., 'I'm not sure but...', 'Maybe you...', 'I guess you...') to express curiosity about the adolescent's internal state and guide focus on experience rather than fact-filling.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="Collaborative Exploration">
      <data key="d0">Collaborative Exploration</data>
      <data key="d1">method</data>
      <data key="d2">The process of jointly exploring the quality of feelings with the adolescent, avoiding imposing one's own emotional vocabulary.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="Fixed Safety Protocol">
      <data key="d0">Fixed Safety Protocol</data>
      <data key="d1">method</data>
      <data key="d2">A fixed safety protocol that handles crisis scenarios, distinct from the low-risk guidance.&lt;SEP&gt;A protocol that handles crisis scenarios, separate from this guidance.&lt;SEP&gt;A predetermined procedure for handling crisis scenarios where psychic equivalence guidance is not suitable.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000&lt;SEP&gt;doc-25e2ba2136d79300ee648940-chunk-000&lt;SEP&gt;doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md&lt;SEP&gt;GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md&lt;SEP&gt;GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Low-Risk Non-Diagnostic Direct Psychological Support">
      <data key="d0">Low-Risk Non-Diagnostic Direct Psychological Support</data>
      <data key="d1">concept</data>
      <data key="d2">The scope of application for the mentalizing stance guidance, limited to low-risk, non-diagnostic direct psychological support.&lt;SEP&gt;The scope of application for this guidance: only for low-risk, non-diagnostic settings.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784709610</data>
      <data key="d6" />
    </node>
    <node id="Cooperative Mentalizing">
      <data key="d0">Cooperative Mentalizing</data>
      <data key="d1">concept</data>
      <data key="d2">The goal of restoring collaborative mentalizing between the therapist and adolescent through joint exploration of subjective experience.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="Curiosity">
      <data key="d0">Curiosity</data>
      <data key="d1">concept</data>
      <data key="d2">A clear curiosity expressed through tentative language, central to the mentalizing stance and used to guide focus on experience.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="Not-Knowing">
      <data key="d0">Not-Knowing</data>
      <data key="d1">concept</data>
      <data key="d2">A stance of acknowledging uncertainty, used to invite the adolescent to correct or supplement without imposing interpretations.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="Non-Expert">
      <data key="d0">Non-Expert</data>
      <data key="d1">concept</data>
      <data key="d2">A non-expert attitude that avoids pretending to know the adolescent's feelings, part of the mentalizing stance.</data>
      <data key="d3">doc-c5160492e097bac38980aeda-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-MENTALIZING-STANCE.md</data>
      <data key="d5">1784709531</data>
      <data key="d6" />
    </node>
    <node id="GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT">
      <data key="d0">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT</data>
      <data key="d1">data</data>
      <data key="d2">An identifier for a guidance topic on adolescent development providing a framework for understanding and supporting adolescent behaviors.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Adolescent Development">
      <data key="d0">Adolescent Development</data>
      <data key="d1">concept</data>
      <data key="d2">The overall developmental process during adolescence encompassing autonomy, peer relationships, identity, and related tasks.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Autonomy">
      <data key="d0">Autonomy</data>
      <data key="d1">concept</data>
      <data key="d2">A key developmental task in adolescence involving the desire for independence and self-governance.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Peer Relationships">
      <data key="d0">Peer Relationships</data>
      <data key="d1">concept</data>
      <data key="d2">Social connections with peers that become particularly important during adolescence.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Identity">
      <data key="d0">Identity</data>
      <data key="d1">concept</data>
      <data key="d2">The process of forming a sense of self, a major developmental task in adolescence.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Evolutionary Mismatch">
      <data key="d0">Evolutionary Mismatch</data>
      <data key="d1">concept</data>
      <data key="d2">The concept that modern adolescent developmental challenges arise from a mismatch between evolved expectations and current social environments, such as lack of adult role models and imbalance of responsibility and autonomy.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Adaptive Difficulties">
      <data key="d0">Adaptive Difficulties</data>
      <data key="d1">concept</data>
      <data key="d2">Adjustment problems that adolescents may face due to evolutionary mismatch, but which should not be pathologized.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Pathologization">
      <data key="d0">Pathologization</data>
      <data key="d1">concept</data>
      <data key="d2">The incorrect framing of normal adolescent behaviors as pathological or problematic.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Developmental Scaffolding">
      <data key="d0">Developmental Scaffolding</data>
      <data key="d1">method</data>
      <data key="d2">A technique to provide support and guidance to help adolescents return to adaptive developmental trajectories and overcome avoidance patterns.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Adaptive Developmental Trajectory">
      <data key="d0">Adaptive Developmental Trajectory</data>
      <data key="d1">concept</data>
      <data key="d2">The desired path of development that is healthy and adaptive for adolescents.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Agency">
      <data key="d0">Agency</data>
      <data key="d1">concept</data>
      <data key="d2">The sense of control and ability to act independently, which is enhanced through the guidance.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Intergenerational Connection">
      <data key="d0">Intergenerational Connection</data>
      <data key="d1">concept</data>
      <data key="d2">The promotion of connections between generations, balancing adolescent autonomy needs with family involvement.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Low-Risk Non-Diagnostic Psychological Support">
      <data key="d0">Low-Risk Non-Diagnostic Psychological Support</data>
      <data key="d1">concept</data>
      <data key="d2">The scope of this guidance, limited to non-diagnostic support in low-risk situations.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Crisis Safety Protocol">
      <data key="d0">Crisis Safety Protocol</data>
      <data key="d1">other</data>
      <data key="d2">A fixed safety protocol for handling crisis scenarios, separate from this guidance.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Normalization">
      <data key="d0">Normalization</data>
      <data key="d1">concept</data>
      <data key="d2">The process of framing adolescent behaviors as normal developmental phenomena rather than pathological.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Lack Of Adult Role Models">
      <data key="d0">Lack Of Adult Role Models</data>
      <data key="d1">concept</data>
      <data key="d2">The absence of consistent adult role models, contributing to evolutionary mismatch in adolescent development.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Responsibility-Autonomy Imbalance">
      <data key="d0">Responsibility-Autonomy Imbalance</data>
      <data key="d1">concept</data>
      <data key="d2">An imbalance between the responsibilities placed on adolescents and their level of autonomy, contributing to evolutionary mismatch.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Actual Self-Ideal Self Gap">
      <data key="d0">Actual Self-Ideal Self Gap</data>
      <data key="d1">concept</data>
      <data key="d2">The discrepancy between an adolescent's actual self and their ideal self, a source of distress.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="Peer Prioritization">
      <data key="d0">Peer Prioritization</data>
      <data key="d1">concept</data>
      <data key="d2">The tendency for adolescents to prioritize peer relationships over other domains, a normal developmental behavior.</data>
      <data key="d3">doc-cbd65c5b9066cfdab9aefc4e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-ADOLESCENT-DEVELOPMENT.md</data>
      <data key="d5">1784709548</data>
      <data key="d6" />
    </node>
    <node id="GUIDANCE-TOPIC-HYPERMENTALIZING">
      <data key="d0">GUIDANCE-TOPIC-HYPERMENTALIZING</data>
      <data key="d1">concept</data>
      <data key="d2">A topic identifier for a guidance framework addressing adolescent over-mentalizing.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Adolescent Over-Mentalizing">
      <data key="d0">Adolescent Over-Mentalizing</data>
      <data key="d1">concept</data>
      <data key="d2">A cognitive pattern where adolescents make overly complex and definitive inferences about others' intentions, detached from observable facts.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Overthinking">
      <data key="d0">Overthinking</data>
      <data key="d1">concept</data>
      <data key="d2">A related concept involving excessive thinking that is a clue for over-mentalizing.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Uncertainty">
      <data key="d0">Uncertainty</data>
      <data key="d1">concept</data>
      <data key="d2">A state that the framework aims to restore tolerance for, as opposed to over-certainty in inference.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Observable Facts">
      <data key="d0">Observable Facts</data>
      <data key="d1">concept</data>
      <data key="d2">Concrete, verifiable information that mentalizing should be grounded in.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Technique Identify and Challenge Over-Mentalizing">
      <data key="d0">Technique Identify and Challenge Over-Mentalizing</data>
      <data key="d1">method</data>
      <data key="d2">A technique to gently point out when an adolescent's thoughts may have jumped too far and invite them back to observable facts.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Step Distinguish Facts from Speculation">
      <data key="d0">Step Distinguish Facts from Speculation</data>
      <data key="d1">method</data>
      <data key="d2">A step to help adolescents differentiate between what is known and what is guessed, encouraging openness to uncertainty.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Reply Examples">
      <data key="d0">Reply Examples</data>
      <data key="d1">content</data>
      <data key="d2">Example responses illustrating how to apply the technique, such as asking about actual observations and distinguishing knowledge from guesses.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Avoidances">
      <data key="d0">Avoidances</data>
      <data key="d1">concept</data>
      <data key="d2">Behaviors to avoid, including reinforcing over-speculation and directly negating thoughts without exploration.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Scope">
      <data key="d0">Scope</data>
      <data key="d1">concept</data>
      <data key="d2">The intended application limited to low-risk, non-diagnostic psychological support; crisis situations are handled by fixed safety protocols.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Inaccurate Attribution of Others' Motives or Feelings">
      <data key="d0">Inaccurate Attribution of Others' Motives or Feelings</data>
      <data key="d1">concept</data>
      <data key="d2">A clue for over-mentalizing where an adolescent makes incorrect assumptions about others' motives or feelings.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Feelings and Thoughts Jumping Too Many Steps from Reality">
      <data key="d0">Feelings and Thoughts Jumping Too Many Steps from Reality</data>
      <data key="d1">concept</data>
      <data key="d2">A clue for over-mentalizing where feelings and thoughts leap excessively from observable reality.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Over-Inference of Others' Intentions">
      <data key="d0">Over-Inference of Others' Intentions</data>
      <data key="d1">concept</data>
      <data key="d2">A clue for over-mentalizing involving excessive inference about what others intend.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="First Step Gently Point Out and Invite Back to Facts">
      <data key="d0">First Step Gently Point Out and Invite Back to Facts</data>
      <data key="d1">method</data>
      <data key="d2">A step to gently point out that thoughts may have jumped too far and invite the adolescent back to observable facts.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Here-and-Now Feelings">
      <data key="d0">Here-and-Now Feelings</data>
      <data key="d1">concept</data>
      <data key="d2">The present-moment feelings that the technique aims to help adolescents connect to.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="Over-Speculation">
      <data key="d0">Over-Speculation</data>
      <data key="d1">concept</data>
      <data key="d2">Excessive speculation that should not be reinforced according to the avoidances.</data>
      <data key="d3">doc-2b72bc71b9ce39347784bb98-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-HYPERMENTALIZING.md</data>
      <data key="d5">1784709561</data>
      <data key="d6" />
    </node>
    <node id="GUIDANCE-TOPIC-TELEOLOGICAL-MODE">
      <data key="d0">GUIDANCE-TOPIC-TELEOLOGICAL-MODE</data>
      <data key="d1">concept</data>
      <data key="d2">A topic identifier for guidance on teleological mode in adolescents, focusing on connecting actions to mental states.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Teleological Mode">
      <data key="d0">Teleological Mode</data>
      <data key="d1">concept</data>
      <data key="d2">A cognitive mode where individuals only consider concrete actions or external outcomes as real, making it difficult to explore mental states behind actions.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Action">
      <data key="d0">Action</data>
      <data key="d1">concept</data>
      <data key="d2">Concrete behaviors or external results that adolescents in teleological mode focus on.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Mental State">
      <data key="d0">Mental State</data>
      <data key="d1">concept</data>
      <data key="d2">Internal psychological states such as feelings and thoughts that the guidance aims to connect to actions.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Emotion">
      <data key="d0">Emotion</data>
      <data key="d1">concept</data>
      <data key="d2">Feelings that may be difficult to identify in teleological mode; the guidance helps recognize them.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Feeling">
      <data key="d0">Feeling</data>
      <data key="d1">concept</data>
      <data key="d2">One type of mental state; the guidance helps distinguish feelings from thoughts.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Thought">
      <data key="d0">Thought</data>
      <data key="d1">concept</data>
      <data key="d2">One type of mental state; the guidance helps distinguish thoughts from feelings.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Curious and Non-judgmental Stance">
      <data key="d0">Curious and Non-judgmental Stance</data>
      <data key="d1">concept</data>
      <data key="d2">The mentalizing stance recommended for the guidance, characterized by curiosity and lack of judgment.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Gentle Challenge">
      <data key="d0">Gentle Challenge</data>
      <data key="d1">method</data>
      <data key="d2">A technique used in the guidance to challenge the teleological mode gently through questioning.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Questioning">
      <data key="d0">Questioning</data>
      <data key="d1">method</data>
      <data key="d2">The technique of asking questions to guide adolescents to explore feelings and thoughts behind actions.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Low-risk Non-diagnostic Direct Psychological Support">
      <data key="d0">Low-risk Non-diagnostic Direct Psychological Support</data>
      <data key="d1">method</data>
      <data key="d2">The scope of application for this guidance; it is used for low-risk, non-diagnostic support.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Analogical Connection">
      <data key="d0">Analogical Connection</data>
      <data key="d1">concept</data>
      <data key="d2">A technique to avoid during teleological mode, as it may not be appropriate.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Acting Without Thinking">
      <data key="d0">Acting Without Thinking</data>
      <data key="d1">concept</data>
      <data key="d2">A behavioral clue of teleological mode where adolescents act impulsively without considering underlying mental states.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Confusion of Feelings and Thoughts">
      <data key="d0">Confusion of Feelings and Thoughts</data>
      <data key="d1">concept</data>
      <data key="d2">A characteristic of teleological mode where adolescents have difficulty distinguishing between feelings and thoughts.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Attribution of Emotions to Concrete Events">
      <data key="d0">Attribution of Emotions to Concrete Events</data>
      <data key="d1">concept</data>
      <data key="d2">A clue of teleological mode where emotional causes are attributed to specific observable events.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Concrete Actions as Evidence of Care">
      <data key="d0">Concrete Actions as Evidence of Care</data>
      <data key="d1">concept</data>
      <data key="d2">A clue of teleological mode where only concrete actions are recognized as evidence of care.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Guidance Steps for Teleological Mode">
      <data key="d0">Guidance Steps for Teleological Mode</data>
      <data key="d1">method</data>
      <data key="d2">The sequence of three steps in the guidance: identifying teleological mode signals, questioning, and distinguishing feelings and thoughts.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
