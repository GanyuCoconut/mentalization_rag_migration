    </node>
    <node id="Direct Psychological Support">
      <data key="d0">Direct Psychological Support</data>
      <data key="d1">method</data>
      <data key="d2">Non-diagnostic psychological assistance for low-risk situations, using the guidance.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
