    </node>
    <node id="Identification of Teleological Mode Signals">
      <data key="d0">Identification of Teleological Mode Signals</data>
      <data key="d1">method</data>
      <data key="d2">The first step of the guidance, recognizing signals such as focus on concrete actions and difficulty identifying emotions.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Distinguishing Feelings and Thoughts">
      <data key="d0">Distinguishing Feelings and Thoughts</data>
      <data key="d1">method</data>
      <data key="d2">The third step of the guidance, helping adolescents differentiate between feelings and thoughts and reflect on interpersonal experiences.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Response Examples for Teleological Mode">
      <data key="d0">Response Examples for Teleological Mode</data>
      <data key="d1">content</data>
      <data key="d2">Example responses that demonstrate questioning techniques, such as asking about alternative reasons for a friend not replying or exploring the consequences of extending therapy time.</data>
      <data key="d3">doc-25e2ba2136d79300ee648940-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-TELEOLOGICAL-MODE.md</data>
      <data key="d5">1784709586</data>
      <data key="d6" />
    </node>
    <node id="Psychic Equivalence">
      <data key="d0">Psychic Equivalence</data>
      <data key="d1">concept</data>
      <data key="d2">A psychological state where inner feelings are experienced as absolute external reality, causing difficulty distinguishing internal thoughts from external facts.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Inner Feelings">
      <data key="d0">Inner Feelings</data>
      <data key="d1">concept</data>
      <data key="d2">Subjective emotional experiences of an individual.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="External Reality">
      <data key="d0">External Reality</data>
      <data key="d1">concept</data>
      <data key="d2">Objective facts and events outside the individual's mind.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Anxiety">
      <data key="d0">Anxiety</data>
      <data key="d1">concept</data>
      <data key="d2">A feeling of worry or unease resulting from difficulty distinguishing inner feelings from external reality.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Distress">
      <data key="d0">Distress</data>
      <data key="d1">concept</data>
      <data key="d2">Suffering or pain caused by psychic equivalence.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Individual">
      <data key="d0">Individual</data>
      <data key="d1">person</data>
      <data key="d2">A person who experiences psychic equivalence and struggles to distinguish feelings from facts.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Multi-perspective Thinking">
      <data key="d0">Multi-perspective Thinking</data>
      <data key="d1">concept</data>
      <data key="d2">The ability to consider alternative viewpoints and not be locked into a single interpretation.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Emotion Validation">
      <data key="d0">Emotion Validation</data>
      <data key="d1">method</data>
      <data key="d2">A technique of acknowledging and accepting the individual's feelings without judgment.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
