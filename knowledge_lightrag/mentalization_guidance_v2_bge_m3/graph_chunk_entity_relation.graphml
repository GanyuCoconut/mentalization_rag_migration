    <node id="Psychic Equivalence Guidance">
      <data key="d0">Psychic Equivalence Guidance</data>
      <data key="d1">content</data>
      <data key="d2">The topic guidance document or framework for addressing psychic equivalence, including steps and examples.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
