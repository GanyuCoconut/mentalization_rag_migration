    </node>
    <node id="Mentalization Stance">
      <data key="d0">Mentalization Stance</data>
      <data key="d1">concept</data>
      <data key="d2">A psychological approach that involves validating emotions and adopting non-judgmental and non-hating attitudes.&lt;SEP&gt;The therapeutic stance that involves empathically understanding the adolescent's emotional experience and normalizing automatic mentalization responses under stress.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000&lt;SEP&gt;doc-2526c2542d1fb9e5640b1a30-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md&lt;SEP&gt;GUIDANCE-TOPIC-AROUSAL.md</data>
      <data key="d5">1784709610</data>
      <data key="d6" />
    </node>
    <node id="Non-judgmental Attitude">
      <data key="d0">Non-judgmental Attitude</data>
      <data key="d1">concept</data>
      <data key="d2">An attitude of not judging or criticizing the adolescent's feelings, part of the mentalization stance.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Non-hating Attitude">
      <data key="d0">Non-hating Attitude</data>
      <data key="d1">concept</data>
      <data key="d2">An attitude of not showing hatred or hostility toward the adolescent, part of the mentalization stance.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Perceiving Criticism as Threatening Attack">
      <data key="d0">Perceiving Criticism as Threatening Attack</data>
      <data key="d1">concept</data>
      <data key="d2">A symptom of psychic equivalence where the individual interprets criticism as a threatening attack.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Rejecting Feelings as Literal Pain">
      <data key="d0">Rejecting Feelings as Literal Pain</data>
