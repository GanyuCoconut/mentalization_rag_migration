    </node>
    <node id="Alternative Perspective">
      <data key="d0">Alternative Perspective</data>
      <data key="d1">concept</data>
      <data key="d2">A different way of interpreting a situation or feeling, used to challenge psychic equivalence.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
      <data key="d5">1784709608</data>
      <data key="d6" />
    </node>
    <node id="Distinguishing Feelings from Facts">
      <data key="d0">Distinguishing Feelings from Facts</data>
      <data key="d1">concept</data>
      <data key="d2">The goal of helping the individual separate subjective feelings from objective reality.</data>
      <data key="d3">doc-6cf41428683918a1a6480b7e-chunk-000</data>
      <data key="d4">GUIDANCE-TOPIC-PSYCHIC-EQUIVALENCE.md</data>
